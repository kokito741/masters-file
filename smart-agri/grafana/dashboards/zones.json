  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Soil moisture (current)",
      "type": "gauge",
      "datasource": {
        "type": "postgres",
        "uid": "CrateDB"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "green",
                "value": 35
              },
              {
                "color": "blue",
                "value": 70
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  time_index AS \"time\",\n  entity_id AS metric,\n  soilmoisture\nFROM mtsmartfarm.etzone\nWHERE time_index >= $__timeFrom() AND time_index <= $__timeTo()\n  AND soilmoisture IS NOT NULL\nORDER BY time_index",
          "datasource": {
            "type": "postgres",
            "uid": "CrateDB"
          }
        }
      ]
    },
